MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scavenger_hunt_2_0
APP_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=your-admin-username
# Recommended: generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
GAME_NAME=Scavenger Hunt 2.0 — CodeChef

# URL of the Next.js frontend; used for CORS and QR payloads.
FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
PUBLIC_APP_URL=https://YOUR-FRONTEND.vercel.app
